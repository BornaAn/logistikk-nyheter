// Prisma schema for the logistics news aggregator

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  shipping
  trucking
  lager_forsyningskjede
  norge
  globalt_geopolitikk
}

enum AccessLevel {
  full
  limited
}

enum SummaryStatus {
  pending
  done
  failed
}

model Article {
  id String @id @default(cuid())

  title      String
  sourceName String
  sourceUrl  String
  articleUrl String @unique

  publishedAt DateTime
  fetchedAt   DateTime @default(now())

  // Raw content pulled from the source (RSS description or scraped/extracted
  // article body). Internal only — never rendered in the UI, kept for
  // debugging and as the input to the summarizer.
  rawExcerpt String?

  // AI-generated summary actually shown in the UI.
  aiSummary String?

  category    Category?
  accessLevel AccessLevel @default(full)

  summaryStatus SummaryStatus @default(pending)
  summaryError  String?
  summarizedAt  DateTime?

  createdAt DateTime @updatedAt

  concepts ArticleConcept[]
  sectors  ArticleSector[]
  disruptionAnalysis DisruptionAnalysis?

  @@index([publishedAt])
  @@index([category])
  @@index([sourceName])
  @@index([summaryStatus])
}

// Links an article to 0-2 entries from the curated list in
// src/lib/sectors.ts — same pattern as ArticleConcept. Lets a sector page
// (e.g. "Sjømat og fiskeri") show only articles Claude judged genuinely
// relevant to businesses in that sector, not just keyword matches.
model ArticleSector {
  id         String @id @default(cuid())
  articleId  String
  sectorSlug String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, sectorSlug])
  @@index([sectorSlug])
}

// On-demand "Analyser forstyrrelse" result (src/lib/disruptionAnalysis.ts),
// generated only when a reader clicks the button on an article — never
// automatically during ingest, since the four-step analysis is a heavier
// Claude call than the regular summary and not relevant to every article.
// Cached one-to-one per article so re-opening the panel doesn't re-run it.
model DisruptionAnalysis {
  id        String   @id @default(cuid())
  articleId String   @unique
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime @default(now())
}

// Links an article to 0-3 entries from the curated glossary in
// src/lib/concepts.ts. conceptSlug references that code-based list (same
// pattern as Article.sourceName referencing sources.ts) rather than a
// separate Concept table, since the definitions are curated, not
// user-editable.
model ArticleConcept {
  id          String @id @default(cuid())
  articleId   String
  conceptSlug String
  whyRelevant String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, conceptSlug])
  @@index([conceptSlug])
}

model FetchLog {
  id        String   @id @default(cuid())
  runAt     DateTime @default(now())
  sourcesOk Int
  sourcesFailed Int
  articlesFound Int
  articlesNew   Int
  summariesOk   Int
  summariesFailed Int
  errors    String?
}

// Single-row durable cache of the last successfully fetched pensum-
// koblinger feed (see src/lib/pensumKoblinger.ts). Next's own fetch cache
// already avoids re-fetching within the hour, but its stale-on-error
// guarantee applies clearly to whole-page ISR regeneration, not
// unambiguously to a single fetch() inside a Server Component, and it
// doesn't survive a redeploy either way. This makes "keep showing the last
// good version if the source is briefly down" an explicit, verifiable
// guarantee instead of relying on undocumented framework internals —
// deliberately important since the teacher may be showing this live in a
// lecture.
model PensumFeedCache {
  id         String   @id @default("singleton")
  fetchedAt  DateTime @default(now())
  data       Json
}
